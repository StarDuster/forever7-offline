# Resource metadata (IDs, hashes, offsets, paths and layout parameters) stays versioned.
# Game media stays excluded; the pinned Project7 component is the one exception,
# shipped so a clone can build without an extra download.
vendor/*
!vendor/project7/
vendor/project7/*
!vendor/project7/component-v2.10.1.zip

# Analysis output stays local; only explicitly listed machine-readable contracts are versioned.
/reports/*

# Local secrets and signing material (never commit, including via LFS).
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
**/credentials.json
**/secrets.json
**/passwords.json

# Private local save checkpoints and their pulled fixtures (never export).
/local-checkpoints/

# Exported source checkout: keep generated dependencies/media/private data local.
/.offline-build*/
/.offline-deps/
**/signing/
*.bson
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.mp3
*.ogg
*.wav
*.mp4
*.atlas
*.plist

